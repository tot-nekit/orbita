# Local setup: python -m scripts.configure. Do not commit .env or copy real secrets into chat.
HOST=127.0.0.1
PORT=8000
APP_ENV=local
# Managed free hosting: use python -m scripts.prepare_hosted and docs/archive/ALWAYSDATA.md.
# HOSTING_PROFILE=alwaysdata
# TRUSTED_PROXY_CIDRS= (only verified immediate platform proxy addresses)
# Required for a public service. 0 is an explicit local-only shared workspace.
AUTH_REQUIRED=1
# Install requirements.txt before enabling. Never reuse the session secret as a DB key.
DATABASE_ENCRYPTION=1
# Generate a file: python -m scripts.manage keygen --output data/.database_key
# Keep a separate private backup of this key; losing it makes data unreadable.
DATABASE_KEY_FILE=data/.database_key
# Production: set DATABASE_KEY to a base64url encoding of 32 random bytes in hosting secrets.
# DATABASE_KEY=
# At least 32 random characters. Required by Docker/production recipes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SESSION_SECRET=
# 0 for localhost HTTP; 1 for public HTTPS.
COOKIE_SECURE=0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://vyceai.com/v1
OPENAI_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_TIMEOUT=16
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.1
AI_DAILY_USER_LIMIT=50
AI_DAILY_LIMIT=1000
# Vyce chat support does not imply speech support. Configure a speech provider separately.
STT_ENABLED=0
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling for a VPS/local worker; webhook for managed hosting with scheduled.py.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# Safe default: restricted access. /id in the bot returns your own numeric ID.
TELEGRAM_ALLOWED_USER_IDS=
# Set to 1 ONLY if you deliberately want a public bot and accept API spending.
TELEGRAM_ALLOW_PUBLIC=0
# Same HTTPS origin as the server; no trailing /mini.
PUBLIC_BASE_URL=
# DATABASE_PATH=/absolute/path/to/orbita.sqlite3
